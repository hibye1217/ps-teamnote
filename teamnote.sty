\newcommand{\citationneeded}[1]{\textcolor{gray}{#1}}
\newcommand{\warning}[1]{\textbf{\textcolor{red}{#1}}}
\newcommand{\todo}[1]{\textit{\textcolor{red}{TODO: #1}}}
\newcommand{\refer}[2]{\textit{Also check \textcolor{cyan}{\hyperref[#1]{#2}} at page \pageref{#1}.}}

\newcommand{\explanation}[1]{
	\ifthenelse{\boolean{HideExplanation}}{}{
		#1
	}
}
\newcommand{\variable}[3]{
	\ifthenelse{\boolean{HideVariable}}{}{
		\begin{itemize}[label=$\circ$]
			\item \textbf{#1} \texttt{#2}: #3
		\end{itemize}
	}
}
\newcommand{\complexity}[1]{
	\begin{itemize}[label=$\circ$]
		\item \textbf{Time Complexity}: #1.
	\end{itemize}
}

\newcommand{\maketitlepage}{
    \maketitle
