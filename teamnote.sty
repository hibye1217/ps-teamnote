}

\definecolor{LED_BLUE}  {RGB}{ 64,  64, 255}
\definecolor{LED_GREEN} {RGB}{  0, 192,   0}
\definecolor{LED_YELLOW}{RGB}{255, 192,   0}
\definecolor{LED_ORANGE}{RGB}{255, 128,   0}
\definecolor{LED_RED}   {RGB}{255,  64,  64}
\newcommand{\subject}[3]{
	\ifthenelse{\( \boolean{HideEasy} \AND \equal{#2}{Easy} \) \OR \( \boolean{HideHard} \AND \equal{#2}{Hard} \) \OR \equal{#2}{Hide}}{}{
		\section{#1}
		#3
	}
}
\newcommand{\algorithm}[4]{
	\ifthenelse{\( \boolean{HideEasy} \AND \equal{#3}{Easy} \) \OR \( \boolean{HideHard} \AND \equal{#3}{Hard} \) \OR \equal{#3}{Hide} \OR \equal{#4}{-}}{}{
		\ifthenelse{\boolean{TrustedOnly} \AND \NOT \equal{#1}{Completed}}{}{
			\ifthenelse{\boolean{ExtraInfo}}{
				\subsection{[#1] #2 (#3)}
			}{
				\ifthenelse{\boolean{ShowIndicator}}{
					\ifthenelse{\equal{#1}{Completed}}{\subsection{\textcolor{LED_BLUE}  {\textbf{\textbullet}} #2}}{}
					\ifthenelse{\equal{#1}{ToRevise}} {\subsection{\textcolor{LED_GREEN} {\textbf{\textbullet}} #2}}{}
					\ifthenelse{\equal{#1}{ToTest}}   {\subsection{\textcolor{LED_YELLOW}{\textbf{\textbullet}} #2}}{}
					\ifthenelse{\equal{#1}{ToAdd}}    {\subsection{\textcolor{LED_ORANGE}{\textbf{\textbullet}} #2}}{}
					\ifthenelse{\equal{#1}{ToLearn}}  {\subsection{\textcolor{LED_RED}   {\textbf{\textbullet}} #2}}{}
				}{\subsection{#2}}
			}
			\ifthenelse{\boolean{TrustedOnly}}{
				\immediate\write18{python -u preprocessor.py Code/#4 Code/temp.tmp true}
			}{
				\immediate\write18{python -u preprocessor.py Code/#4 Code/temp.tmp false}
			}
			\immediate\import{./Code/}{./temp.tmp}
		}
	}
}